# Copy this file to .env for local development.
# In production (Render, etc.) set these as real environment variables in the
# hosting dashboard — never commit a real .env file.

# From the Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# The Twilio WhatsApp sender number, in "whatsapp:+1415XXXXXXX" format.
# While testing, this is the Twilio Sandbox number shown in
# Console > Messaging > Try it out > Send a WhatsApp message.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# The restaurant owner's WhatsApp number that finished orders are sent to,
# in "whatsapp:+34XXXXXXXXX" format.
OWNER_WHATSAPP_NUMBER=whatsapp:+34600000000

# From https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The public HTTPS base URL of this deployed service, e.g.
# https://machado-kebab-bot.onrender.com
# Used to validate Twilio's webhook signature.
PUBLIC_BASE_URL=https://your-app.onrender.com

# Port the server listens on locally (Render sets its own PORT automatically).
PORT=3000
