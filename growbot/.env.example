# Slack app credentials (see README.md for how to create the app)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Anthropic API key used for the "smart" kudos classification
ANTHROPIC_API_KEY=sk-ant-your-key

# Emoji Growbot reacts with when it logs a kudos (no colons)
GROWBOT_REACTION=seedling
