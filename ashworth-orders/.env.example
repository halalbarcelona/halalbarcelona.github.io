# Server
PORT=3000

# Admin inbox login (HTTP Basic Auth on /admin and /api/admin/*).
# Required — the admin panel refuses all requests if ADMIN_PASSWORD is unset.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Where new-order notifications get sent (your own inbox).
NOTIFY_EMAIL=you@example.com

# Outgoing email (SMTP) — powers both the "new order" notification to you
# and the "reply" email sent to the customer. Optional: if left unset, the
# app still works fully as an admin-dashboard-only inbox (orders/replies
# just get logged to the console instead of emailed).
#
# Easiest free option: a Gmail account + an "App Password" (Google Account
# -> Security -> 2-Step Verification -> App passwords). No billing, no API
# signup — just a 16-character password Google generates for you.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Ashworth <you@gmail.com>"
