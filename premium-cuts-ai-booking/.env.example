# Copy this file to .env for local development.
# Never commit a real .env file — it's already covered by .gitignore.

# The chat assistant is a local rule-based "mini AI" (src/miniAiAgent.js) —
# no external AI API key needed at all.

# From your Square Developer Dashboard (https://developer.squareup.com/apps)
# -> your Application -> Sandbox (or Production) -> Access Token.
SQUARE_ACCESS_TOKEN=your_square_access_token

# "sandbox" for testing (default), "production" once you're live.
SQUARE_ENVIRONMENT=sandbox

# Optional: pin a specific Square location. If omitted, the app uses your
# account's first location automatically.
# SQUARE_LOCATION_ID=your_location_id

# Port the server listens on.
PORT=3000
